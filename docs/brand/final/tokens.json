{
  "$description": "AirLinx — tokeny marki (kierunek C „Styk”). Dark-first; neutrale zgodne z UI „OLED Cinema”.",
  "color": {
    "dark": {
      "bg": {
        "$value": "#000000",
        "$type": "color",
        "role": "tło okna i ekranu TV (OLED: czysta czerń)"
      },
      "surface": {
        "$value": "#0D0D0D",
