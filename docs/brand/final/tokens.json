  "logo": {
    "ink-dark": "#F3F2EF",
    "ink-light": "#0E0E0D",
    "frame-dark": "#3DF2A0",
    "frame-light": "#007A47",
    "clearspace": "2X, X = szerokość rombu",
    "min-size": {
      "symbol": "16px",
      "lockup-horizontal": "20px wysokości",
      "lockup-vertical": "56px wysokości"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "\"JetBrains Mono\", ui-monospace, monospace",
        "use": "logotyp, nagłówki ekranu TV, wszystkie liczby",
        "license": "SIL Open Font License 1.1",
        "source": "https://www.jetbrains.com/lp/mono/"
      },
      "ui": {
        "$value": "\"Inter\", \"Cantarell\", system-ui, sans-serif",
        "use": "tekst interfejsu i opisy",
        "license": "SIL Open Font License 1.1",
        "source": "https://rsms.me/inter/"
      },
      "mono": {
        "$value": "\"JetBrains Mono\", ui-monospace, monospace",
        "use": "statystyki na żywo (ms, kl./s, Mb/s), IP",
        "license": "SIL Open Font License 1.1",
        "source": "https://www.jetbrains.com/lp/mono/"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "display": 800
    },
    "size": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px",
      "tv-title": "64px",
      "tv-body": "28px"
    },
    "tracking": {
      "display": "-0.04em",
      "title": "-0.01em",
      "body": "0",
      "caps": "0.12em"
    },
    "line-height": {
      "tight": 1.15,
      "normal": 1.45
    }
  },
  "radius": {
    "s": "8px",
    "m": "12px",
    "l": "18px",
    "icon-tile": "22%"
  },
  "motion": {
    "ease-out": "cubic-bezier(.22, 1, .36, 1)",
    "ease-io": "cubic-bezier(.65, 0, .35, 1)",
    "duration-fast": "140ms",
    "duration-base": "220ms",
    "connecting-loop": "1600ms"
  }
